# Copy to airflow/.env and fill in. Never commit the real .env.

# --- Airflow ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
AIRFLOW_UID=50000
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# --- Source API ---
SIMPLER_API_KEY=

# --- Azure Data Lake ---
ADLS_ACCOUNT_NAME=
ADLS_ACCOUNT_KEY=

# --- Snowflake ---
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
# Path to the key INSIDE the container (docker-compose mounts it here)
SNOWFLAKE_PRIVATE_KEY_PATH=/opt/airflow/secrets/rsa_private_key.p8
# Path to the key on YOUR machine (mounted into the container)
SNOWFLAKE_PRIVATE_KEY_PATH_HOST=/absolute/path/to/rsa_private_key.p8

# --- OpenAI ---
OPENAI_API_KEY=

# --- Optional: email the digest ---
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# SMTP_TO=
